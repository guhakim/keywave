# 이 파일을 .env 로 복사한 뒤 값을 채우세요. 비어 있는 칸은 그냥 두면 됩니다.

# 1) 네이버 검색광고 (필수: 월간 검색량·연관 키워드·경쟁 정도)
#    searchad.naver.com → 도구 → API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 2) NAVER API HUB (선택: 블로그 발행량·12개월 그래프)
#    네이버 클라우드 콘솔 → Services → Application Service → NAVER API HUB
#    → 이용 신청 → 앱 등록("검색 - 블로그", "검색어 트렌드" 선택)
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# 3) (예전 방식) 2026-07-31 이전에 네이버 개발자센터에서 받은 키가 있다면 여기에
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 4) Claude API (선택: 🤖 AI 인사이트) — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# 5) Google Gemini (선택: 🤖 AI 인사이트, 무료 사용량 있음) — aistudio.google.com → Get API key
GEMINI_API_KEY=
