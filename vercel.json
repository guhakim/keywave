{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["server.py", "index.html", "setup.html", "docs/**", "posts/**"],
        "maxDuration": 300
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "regions": ["icn1"]
}
